variable "account_id" {
  description = "Cloudflare account ID. Used for every virtual network and route unless one overrides it."
  type        = string
}

variable "virtual_networks" {
  description = <<-EOT
    Map of tunnel virtual networks to create. The map key is the network name
    unless the object sets `name`.

    Per-network keys mirror `cloudflare_zero_trust_tunnel_cloudflared_virtual_network`:
    `name`, `account_id`, `comment`, `is_default_network`.

    Exactly one virtual network per account is the default. Every account gets
    an autogenerated one named `default`; import it rather than declaring a
    second default, or the API flips the flag and the old one silently stops
    receiving routes that omit `virtual_network_id`.
  EOT
  type        = any
  default     = {}
}

variable "routes" {
  description = <<-EOT
    Map of private-network routes to publish through a tunnel. The map key is a
    label only — keep CIDRs out of it, since keys show up in plan output and
    state addresses.

    Per-route keys mirror `cloudflare_zero_trust_tunnel_cloudflared_route`:
    `network` (CIDR, required), `tunnel_id` (required), `comment`,
    `account_id`, `virtual_network_id`.

    Instead of `virtual_network_id`, a route may set `virtual_network` to a key
    of `var.virtual_networks` to bind to a network declared in the same call.
    Omitting both lands the route on the account's default virtual network.

    The tunnel is referenced by ID, not owned. Routes outlive nothing on their
    own — deleting the tunnel deletes its routes on Cloudflare's side.
  EOT
  type        = any
  default     = {}
}
